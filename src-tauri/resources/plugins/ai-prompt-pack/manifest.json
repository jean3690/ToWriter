{
  "name": "ai-prompt-pack",
  "displayName": "AI 提示词增强包",
  "version": "0.1.0",
  "publisher": "towriter",
  "main": "main.js",
  "engines": {
    "towriter": "^0.1.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "aiPromptPack.translate",
        "title": "翻译选中文本为英文",
